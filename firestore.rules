rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Server time sync — any authenticated user may read/write.
    // Used by SubscriptionService.getServerTime() to get a trusted timestamp.
    match /appMeta/serverClock {
      allow read, write: if request.auth != null;
    }

    // User profile document — only the owner can read or write.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // All user subcollections (subscription, payments, readingHistory, etc.)
    // — only the owner can read or write.
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
